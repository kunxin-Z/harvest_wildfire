{com}. gen se_iv_thin=(t_a_se-t_a_c)/(private_arti_se-private_arti_c)*L.private_arti_c+(t_n_se-t_n_c)/(private_natural_se-private_natural_c)*L.private_natural_c
{txt}(5,776 missing values generated)

