           e(countyfe) : "{res:$\checkmark$}"

{com}. estadd local yearfe   "`mark'"

{txt}added macro:
             e(yearfe) : "{res:$\checkmark$}"

{com}. 
. scalar b_ols_cc = _b[logavg_harvest]
{txt}
{com}. 
. *****************************************************
