{txt}(5,052 missing values generated)

{com}. 
. label var ma5_logcc_total "Log average harvest area"
{txt}
{com}. 
. foreach y of local outcomes1 {c -(}
{txt}  2{com}. 
.     qui ivreghdfe `y' ///
>         (ma5_logcc_total = L5.s_iv_harvest) ///
>         $CONTROL if year >= 2000, ///
>         absorb(fips year) ///
>         cluster(fips) first
{txt}  3{com}. 
.     eststo cc_`y'
