. qui ivreghdfe logmtbs_acre ///
>     (logavg_harvest = L5.s_iv_harvest) ///
>     $CONTROL if year >= 2000, ///
>     absorb(fips year) ///
>     cluster(fips)
{txt}
{com}. 
. eststo cc_iv5
{txt}
